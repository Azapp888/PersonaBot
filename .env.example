# ============================================================
# PersonaBot 环境变量示例
# 复制为 .env 后按需修改。所有敏感信息都通过 .env 管理。
# ============================================================

# ----- 服务 -----
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# ----- 跨域（默认关闭）-----
# 管理后台与 API 同源时无需配置；若需前后端分离部署，填写允许携带凭据的来源，逗号分隔
# 生产环境未配置时不会开启 CORS，避免任意来源反射凭据
CORS_ORIGINS=

# ----- 管理后台鉴权 -----
# 生产环境（NODE_ENV=production）若仍为默认值将拒绝启动
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
JWT_SECRET=please-change-this-jwt-secret-to-a-long-random-string

# ----- 敏感字段加密（用于加密存储 QQ ClientSecret / API Key / 绘画 Key / GitHub Token）-----
# 任意长度的字符串，内部会派生为 32 字节密钥；生产环境务必修改
ENCRYPTION_KEY=please-change-this-encryption-key

# ----- 数据与日志 -----
DATA_DIR=./data
LOG_DIR=./logs

# ----- QQ 官方机器人 API v2 -----
# QQ 开发者请根据实际环境调整；官方 Token 地址为 https://bots.qq.com/app/getAppAccessToken
QQ_API_BASE=https://api.sgroup.qq.com
QQ_TOKEN_URL=https://bots.qq.com/app/getAppAccessToken
# 事件订阅 intents（默认 GROUP_AND_C2C_EVENT = 1<<25 = 33554432）
QQ_INTENTS=33554432

# ----- 前端（Vite 开发代理）-----
VITE_API_PROXY_TARGET=http://localhost:3000
